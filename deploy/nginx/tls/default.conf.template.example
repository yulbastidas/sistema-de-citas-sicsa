# Activar solo después de montar certificados reales y sustituir la plantilla HTTP.
server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Copiar aquí las locations y headers de ../templates/default.conf.template.
    # HSTS se habilita únicamente después de validar HTTPS definitivo.
}
