# Copiar como .env para Docker Compose. No versionar valores reales.
NODE_ENV=development
BACKEND_PORT=3000

MYSQL_ROOT_PASSWORD=replace-with-a-local-secret
DB_USERNAME=root
DB_PASSWORD=replace-with-a-local-secret
DB_DATABASE=sicsa
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1h

# Protección de endpoints públicos de autenticación.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_GENERAL_IP_LIMIT=20
AUTH_CODE_MAX_ATTEMPTS=10
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60

# Infraestructura OTP (aún no conectada a endpoints públicos).
OTP_HMAC_SECRET=replace-with-an-independent-random-secret
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10

# Lista separada por comas, sin comodines.
CORS_ORIGINS=http://localhost:3001

AI_SERVICE_URL=http://ai:8000
AI_TIMEOUT_MS=3000

N8N_INTERNAL_TOKEN=replace-with-a-random-service-token
N8N_SECURE_COOKIE=false
N8N_EMAIL_WEBHOOK_URL=http://n8n:5678/webhook/verificacion-aprobada
N8N_VERIFICATION_CODE_WEBHOOK_URL=http://n8n:5678/webhook/verificacion-codigo-email
N8N_APPOINTMENT_CREATED_WEBHOOK_URL=http://n8n:5678/webhook/cita-creada
N8N_WAITLIST_ASSIGNED_WEBHOOK_URL=http://n8n:5678/webhook/lista-espera-asignada
N8N_REMINDER_WEBHOOK_URL=http://n8n:5678/webhook/recordatorio-cita
N8N_PASSWORD_RESET_WEBHOOK_URL=http://n8n:5678/webhook/recuperar-contrasena
N8N_SMS_WEBHOOK_URL=http://n8n:5678/webhook/sicsa-sms
SMS_PROVIDER_MODE=fake
SMS_TIMEOUT_MS=5000

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
